{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmitOnError": true,
    "outDir": ".TMP/build",
    "rootDir": "src",
    "typeRoots": [".TMP/deps/node_modules/@types"],
    "types": ["node"],
    "paths": { "electron": ["./.TMP/deps/node_modules/electron"] },
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
